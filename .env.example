# ==========================================
# Color It Daily Agent - Environment Configuration
# ==========================================

# GCP & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT='your-gcp-project-id'
GOOGLE_CLOUD_LOCATION='global'
GOOGLE_GENAI_USE_VERTEXAI=True

# Models
LLM_MODEL='gemini-3-flash-preview'
MEDIA_MODEL='gemini-3.1-flash-image-preview'

# Cloud Storage & Firestore Collections
GCP_MEDIA_BUCKET='color-it-daily-agent-assets'
COLORING_PAGE_COLLECTION='coloring_pages'
EMBEDDING_COLLECTION='coloring_pages_vectors'
LOCAL_PERSISTENCE=False

# ==========================================
# PostgreSQL Database (Used by daily-push job)
# ==========================================
POSTGRES_HOST='your-postgres-host-ip'
POSTGRES_PORT=5432
POSTGRES_DB='coloring_pages'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='your-postgres-password'

# ==========================================
# Pinterest Distribution Service (jobs/pinterest-publisher)
# ==========================================
# Enable Pinterest Publishing (true / false)
PINTEREST_ENABLED=true

# Buffer API Integration (Recommended - Instant 1-click Pinterest connection)
BUFFER_ACCESS_TOKEN='your_buffer_api_key'
BUFFER_PROFILE_ID='your_buffer_pinterest_profile_id'

# Pinterest Board ID (Numeric Board ID or username/board-slug)
PINTEREST_BOARD_ID='your_pinterest_board_id_or_slug'

# Smart Multi-Board Routing (JSON String mapping tag/category keywords to Board IDs)
PINTEREST_BOARD_MAP='{}'

# Website Base URL for Pin Destination Link
WEBSITE_BASE_URL='https://coloritdaily.com'

# Gemini Copywriting Model for Pinterest
PINTEREST_GEMINI_MODEL='gemini-3.5-flash'

FIRESTORE_PROJECT_ID='firestore_project_id'
